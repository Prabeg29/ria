# Version control / project meta
.git
.gitignore
.github
.dockerignore
Dockerfile
README.md
adr

# Env / secrets
.env
.env.example

# Python tooling / build config not needed at runtime by the runner.
# NOTE: pyproject.toml and uv.lock are intentionally NOT ignored — the
# uv-base stage COPYs them, and .dockerignore applies to the whole context.
.python-version

# Local virtualenv & caches
.venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# Tests (run in CI / dev stage, not shipped in runner)
tests

# Local infra / data / compose
db_data
docker
docker-compose.yml
dev.docker-compose.yml
